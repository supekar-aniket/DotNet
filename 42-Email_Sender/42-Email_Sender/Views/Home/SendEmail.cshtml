@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-sm-12 col-md-8 col-lg-6">
            <div class="card shadow-lg p-4 mt-5">
                <h3 class="text-center mb-4">Send Email</h3>
                <form asp-action="SendEmail" asp-controller="Home">
                    <div class="mb-3">
                        <label for="to">Email</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label for="subject">Subject</label>
                        <input type="text" name="subject" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label for="message">Message</label>
                        <textarea name="message" cols="10" rows="5" class="form-control" required></textarea>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary btn-lg">Send Email</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
