@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="container">

    <div class="row">

        <div class="col-md-4">

            <div class="mb-3">
                <label for="exampleFormControlInput1" class="form-label">First Number</label>
                <input type="text" class="form-control" id="num1" placeholder="First Number">
            </div>

            <div class="mb-3">
                <label for="exampleFormControlInput1" class="form-label">Second Number</label>
                <input type="text" class="form-control" id="num2" placeholder="Second Number">
            </div>

            <button class="btn btn-info btn-sm" onclick="Add()">Add</button>
            <button class="btn btn-info btn-sm" onclick="Subtract()">Subtract</button>
            <button class="btn btn-info btn-sm" onclick="Multiplication()">Multiplication</button>
            <button class="btn btn-info btn-sm" onclick="Divide()">Divide</button>

            <br />

            <h4 id="result"></h4>

        </div>

    </div>

</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script type="text/javascript">

    function Add(){

        var n1 = parseInt($("#num1").val());
        var n2 = parseInt($("#num2").val());

        $.ajax({
            type:'POST',
            url:'@Url.Action("Add")',
            data: {num1 : n1, num2 : n2},
            dataType:'text',
            success: function(response, status, xhr){
                $("#result").text(response);
            },
            error: function(req, status, errorMsg) {
                $("#result").text(errorMsg);
            }
        });

    }

    function Subtract(){

        var n1 = parseInt($("#num1").val());
        var n2 = parseInt($("#num2").val());

        $.ajax({
            type:'POST',
            url:'@Url.Action("Subtract")',
            data: {num1 : n1, num2 : n2},
            dataType:'text',
            success: function(response, status, xhr){
                $("#result").text(response);
            },
            error: function(req, status, errorMsg) {
                $("#result").text(errorMsg);
            }
        });

    }

    function Multiplication(){

        var n1 = parseInt($("#num1").val());
        var n2 = parseInt($("#num2").val());

        $.ajax({
            type:'POST',
            url:'@Url.Action("Multiplication")',
            data: {num1 : n1, num2 : n2},
            dataType:'text',
            success: function(response, status, xhr){
                $("#result").text(response);
            },
            error: function(req, status, errorMsg) {
                $("#result").text(errorMsg);
            }
        });

    }

    function Divide(){

        var n1 = parseInt($("#num1").val());
        var n2 = parseInt($("#num2").val());

        $.ajax({
            type:'POST',
            url:'@Url.Action("Divide")',
            data: {num1 : n1, num2 : n2},
            dataType:'text',
            success: function(response, status, xhr){
                $("#result").text(response);
            },
            error: function(req, status, errorMsg) {
                $("#result").text(errorMsg);
            }
        });

    }

</script>